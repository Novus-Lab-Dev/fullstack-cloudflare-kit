---
import Section from "../../components/ui/Section.astro";
import { stepsContent } from "./steps.content";
---

<Section id="how-it-works" tone="muted">
    <div class="max-w-2xl space-y-4">
        <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">{stepsContent.eyebrow}</p>
        <h2 class="text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">{stepsContent.title}</h2>
        <p class="text-lg leading-8 text-slate-600">{stepsContent.description}</p>
    </div>

    <ol class="mt-14 grid gap-10 sm:grid-cols-3">
        {
            stepsContent.items.map((item) => (
                <li class="space-y-3">
                    <span class="block font-mono text-sm font-semibold text-brand-600">{item.step}</span>
                    <h3 class="text-base font-semibold text-slate-900">{item.title}</h3>
                    <p class="text-sm leading-6 text-slate-600">{item.description}</p>
                </li>
            ))
        }
    </ol>
</Section>
