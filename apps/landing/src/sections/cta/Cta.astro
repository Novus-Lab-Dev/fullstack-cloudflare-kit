---
import Button from "../../components/ui/Button.astro";
import Section from "../../components/ui/Section.astro";
import { ctaContent } from "./cta.content";
---

<Section id="get-started" tone="muted">
    <div
        class="flex flex-col items-start justify-between gap-8 rounded-3xl bg-slate-900 px-8 py-12 sm:px-12 lg:flex-row lg:items-center"
    >
        <div class="max-w-xl space-y-3">
            <h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">{ctaContent.title}</h2>
            <p class="text-base leading-7 text-slate-300">{ctaContent.description}</p>
        </div>

        <div class="flex flex-wrap gap-3">
            <Button href={ctaContent.primaryCta.href} size="lg">{ctaContent.primaryCta.label}</Button>
            <Button href={ctaContent.secondaryCta.href} size="lg" variant="secondary">
                {ctaContent.secondaryCta.label}
            </Button>
        </div>
    </div>
</Section>
