---
import Button from "../components/ui/Button.astro";
import Container from "../components/ui/Container.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" description="The page you were looking for does not exist.">
    <Container class="flex flex-col items-center gap-6 py-32 text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">404</p>
        <h1 class="text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">This page does not exist</h1>
        <p class="max-w-md text-base leading-7 text-slate-600">
            The link may be outdated, or the page may have moved.
        </p>
        <Button href="/">Back to home</Button>
    </Container>
</Layout>
