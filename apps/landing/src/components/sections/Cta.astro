---
import Button from "../ui/Button.astro";
import Section from "../ui/Section.astro";
---

<Section id="get-started" tone="muted">
    <div
        class="flex flex-col items-start justify-between gap-8 rounded-3xl bg-slate-900 px-8 py-12 sm:px-12 lg:flex-row lg:items-center"
    >
        <div class="max-w-xl space-y-3">
            <h2 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">Start sending in minutes</h2>
            <p class="text-base leading-7 text-slate-300">
                Create an account, generate a token and make your first API call today.
            </p>
        </div>

        <div class="flex flex-wrap gap-3">
            <Button href="#get-started" size="lg">Get started</Button>
            <Button href="/docs" size="lg" variant="secondary">Read the docs</Button>
        </div>
    </div>
</Section>
