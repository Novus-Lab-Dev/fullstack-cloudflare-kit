---
import { siteConfig } from "../../common/constants";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
---

<header class="sticky top-0 z-50 border-b border-slate-100 bg-white/80 backdrop-blur">
    <Container class="flex h-16 items-center justify-between gap-6">
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-slate-900">
            <span class="grid size-8 place-items-center rounded-lg bg-brand-600 text-sm text-white">
                {siteConfig.name.slice(0, 1)}
            </span>
            <span>{siteConfig.name}</span>
        </a>

        <nav aria-label="Main" class="hidden items-center gap-8 sm:flex">
            {
                siteConfig.nav.map((item) => (
                    <a href={item.href} class="text-sm text-slate-600 transition-colors hover:text-slate-900">
                        {item.label}
                    </a>
                ))
            }
        </nav>

        <Button href={siteConfig.primaryCta.href}>{siteConfig.primaryCta.label}</Button>
    </Container>
</header>
